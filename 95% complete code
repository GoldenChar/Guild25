int main() {

    int life = 3;  // Player starts with 3 lives
    int score = 0; // Player starts with 0 points
    string userInput;
    int selection;
    int result;
    
    //intro message
    cout << "~~ Welcome to the Labyrinth of Truths and Lies! ~ ~ "<< endl;
    cout << " └(・O・)┘ You were kidnapped by an angry wizard and now you have to escape the forest labyrinth by guessing in which paths"<< endl;
    cout << " the forest gnome guides are telling the truth and which ones they are telling a lie. You can only escape the forest and return home if you guess ___ questions right"<< endl;
    cout << "Your journey begins here:\n[type 'S' to start] or [type 'Q' to quit]" << endl;
    
    cin >> userInput;
    //loop for the main path selection
    do {
        selection = menu();
        if(userInput == "Q"||userInput == "q"){
            cout << "End of Game \nView results below:\n";
            break;
        }
        //Pathing logic
        switch(selection){
            case 1:
                result = askRandomQuestion1();
