                score += 10; // Increase score
                } 
                else {
                    life--; // Decrease life
                }
                break;
            
            case 2:
                result = askRandomQuestion2();
                if (result == 10) {
                score += 10; // Increase score
                } 
                else {
                    life--; // Decrease life
                }
                break;
            
            case 3:
                result = askRandomQuestion3();
                if (result == 10) {
                score += 10; // Increase score
                } 
                else {
                    life--; // Decrease life
                }
                break;
            
            case 4:
                result = askRandomQuestion4();
                if (result == 10) {
                score += 10; // Increase score
                } 
                else {
                    life--; // Decrease life
                }
                break;
                
            default:
                cout << "Invalid input";
        }
        

        cout << "Current Score: " << score << " | Remaining Lives: " << life << endl;

        if (life <= 0) {
            cout << "Game Over! You have lost all your lives.\n view results below:\n" << endl;
            break;
